<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <style>
        #form-inner-div {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;

            input {
                width: 30%;
            }

            button {
                width: 10%;
            }
        }
    </style>
</head>

<body>
    <h1>URL shortener</h1>
    <div>
        <form method="POST" action="/url">
            <div id="form-inner-div">
                <label>Enter the original url</label>
                <input type="text" name="url" placeholder="www.example.com" />
                <button type="submit">Generate</button>
            </div>
        </form>
    </div>
    <h4>Genereated Urls</h4>
    <% if (!locals.urls || locals.urls.length===0) { %>
        <p>No URLs generated yet.</p>
    <% } else { %>
        <table border="1" cellpadding="6" cellspacing="0">
            <thead>
                <tr>
                    <th>S. No.</th>
                    <th>shortId</th>
                    <th>short url</th>
                    <th>redirects (full url)</th>
                    <th>Number of clicks</th>
                </tr>
            </thead>
            <tbody>
                <% locals.urls.forEach((url, index)=> {
                    const fullUrl = `http://localhost:${locals.port}/url/${url.shortId}`;
                    %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td><%= url.shortId %></td>
                        <td>
                            <a href="<%= fullUrl %>" target="_blank">
                                <%= fullUrl %>
                            </a>
                        </td>
                        <td><a href="<%= url.redirectUrl %>"><%= url.redirectUrl %></a></td>
                        <td><%= url.visitHistory.length %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>


</body>

</html>